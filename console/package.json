{
  "name": "aim-console",
  "private": true,
  "version": "1.0.0",
  "description": "AIM Console — Electron + React18 + TS + AntD5 (light theme)",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "smoke": "node scripts/ipc-smoke.cjs",
    "e2e": "node scripts/e2e-engine.cjs",
    "electron": "node scripts/launch-electron.cjs",
    "package": "node scripts/package.cjs",
    "test:state": "node scripts/test-window-state.cjs",
    "test": "node scripts/test-window-state.cjs && node scripts/ipc-smoke.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.2.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
